# =============================================================================
# TA Platform — Docker Compose environment template
# Copy to `.env` (project root) and adjust. Never commit the real `.env`.
# =============================================================================

# --- PostgreSQL --------------------------------------------------------------
TA_DB_USER=ta_user
TA_DB_PASSWORD=CHANGE_ME_strong_password
TA_DB_NAME=ta_platform

# --- Backend -------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
LOG_FORMAT=json
# Comma-separated CORS allow-list for the browser (frontend origin).
CORS_ORIGINS=http://localhost:3000

# --- Frontend ---------------------------------------------------------------------
# Direct mode: the browser calls the backend on its published port.
NEXT_PUBLIC_BACKEND_ORIGIN=http://localhost:8000
