# =============================================================================
# TA Platform — Docker Compose environment template
# Copy to `.env` (project root) and adjust. Never commit the real `.env`.
# =============================================================================

# --- PostgreSQL --------------------------------------------------------------
TA_DB_USER=ta_user
TA_DB_PASSWORD=CHANGE_ME_strong_password
TA_DB_NAME=ta_platform
# Phase 9: service ports are bound to 127.0.0.1 by default. Override ONLY if
# you understand the exposure (e.g. TA_DB_HOST=0.0.0.0 behind a firewall).
TA_DB_HOST=127.0.0.1
TA_API_HOST=127.0.0.1
TA_FRONTEND_HOST=127.0.0.1

# --- Backend -------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
LOG_FORMAT=json
# Comma-separated CORS allow-list for the browser (frontend origin).
CORS_ORIGINS=http://localhost:3000

# --- Phase 9: API authentication -------------------------------------------------
# Bearer tokens guarding every /api/v1 endpoint. APP_ENV=production REFUSES to
# start without at least one token. Generate: python3 -c "import secrets;
# print(secrets.token_urlsafe(32))"
#   API_AUTH_TOKEN  — one deployment-wide token (X-User-Id scoping stays).
#   API_AUTH_TOKENS — CSV of "token" or "token:owner" pairs; a bound token
#                     locks requests to its owner (X-User-Id is then ignored).
API_AUTH_TOKEN=
API_AUTH_TOKENS=

# --- Frontend ---------------------------------------------------------------------
# Direct mode: the browser calls the backend on its published port.
NEXT_PUBLIC_BACKEND_ORIGIN=http://localhost:8000
# Optional deployment access token — must match API_AUTH_TOKEN when the
# backend requires auth. HONEST NOTE: this value ships in the public client
# bundle; it gates the UI like a site password, it is not a per-user secret
# (see docs/operations.md §4).
NEXT_PUBLIC_API_TOKEN=
