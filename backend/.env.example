# =============================================================================
# TA Platform backend — environment template (Phase 1)
# Copy to `backend/.env` and fill in REAL values. Never commit `.env`.
# =============================================================================

# --- Application -------------------------------------------------------------
# local | development | test | staging | production
APP_ENV=local
DEBUG=false

# --- HTTP server ----------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000

# --- Database (PostgreSQL, REQUIRED) ---------------------------------------------
# Format: postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DBNAME
# Docker Compose default would be: postgresql+asyncpg://ta_user:CHANGE_ME@db:5432/ta_platform
DATABASE_URL=postgresql+asyncpg://ta_user:CHANGE_ME@localhost:5432/ta_platform

DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# --- Security ------------------------------------------------------------------------
# Comma-separated absolute origins allowed by CORS (frontend origin).
# Same-origin gateway deployments may leave this empty.
CORS_ORIGINS=http://localhost:3000

# --- Phase 9: API authentication ------------------------------------------------------
# Bearer tokens guarding every /api/v1 endpoint. Server-side only: never sent
# to the browser, never logged, never accepted by endpoints.
#   API_AUTH_TOKEN  - one deployment-wide token (X-User-Id scoping stays).
#   API_AUTH_TOKENS - CSV of "token" or "token:owner" pairs; a token WITH an
#                     owner binding pins requests to that owner and IGNORES
#                     the X-User-Id header (anti-spoofing).
# APP_ENV=production REFUSES to start without at least one token.
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# The frontend needs the same value baked in as NEXT_PUBLIC_API_TOKEN (see the
# honest security note in docs/operations.md).
API_AUTH_TOKEN=
API_AUTH_TOKENS=

# Backtest creation rate limit per owner (mirrors the research/AI limiter).
BACKTEST_MAX_CREATES_PER_MINUTE=10

# --- Observability ----------------------------------------------------------------------
LOG_LEVEL=INFO
# json | console
LOG_FORMAT=json

# --- Market data --------------------------------------------------------------------------
# Only 'mt5' is supported. Live candles require the MetaTrader5 Python package
# (Windows host, or Wine) plus a running, logged-in MT5 terminal — see README.
MARKET_DATA_PROVIDER=mt5

# --- MetaTrader 5 (Phase 2) -----------------------------------------------------------------
# Master switch. Set false to run in the safe disabled mode (e.g. in Linux
# containers, where the MetaTrader5 package cannot run).
MT5_ENABLED=true

# Connect to the terminal during API startup. Off by default: a slow or
# wedged terminal must not make the HTTP server unresponsive. Set true on a
# healthy live host if you want terminal problems surfaced immediately.
MT5_WARMUP_ON_STARTUP=false

# RECOMMENDED: leave LOGIN/PASSWORD/SERVER unset to attach to the terminal's
# own login (no credentials stored anywhere). Only set all three together to
# have the backend perform the terminal login. NEVER commit real values.
# Keep MT5_LOGIN commented out when empty: the setting is an integer and
# pydantic rejects an empty string.
# MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

# Optional absolute path to terminal64.exe (e.g. C:\Program Files\MetaTrader 5\terminal64.exe).
# Configuration-only: no API endpoint accepts paths or executes commands.
MT5_TERMINAL_PATH=

# Bounded, serialized terminal access.
MT5_TIMEOUT_SECONDS=10
MT5_RETRY_ATTEMPTS=3
MT5_RETRY_BACKOFF_SECONDS=1.5

# Candle request limits (API returns a structured 422 beyond the maximum).
MT5_MAX_CANDLES=5000
MT5_DEFAULT_CANDLES=200

# PostgreSQL historical candle cache.
MT5_CACHE_ENABLED=true
MT5_CACHE_MAX_AGE_SECONDS=90
MT5_STALE_AFTER_INTERVALS=3

# --- Phase 6: backtesting -------------------------------------------------------
# Hard cap on primary-timeframe candles per backtest run (walk length).
BACKTEST_MAX_CANDLES=20000
# Warmup candles loaded before the configured start (lookback context).
BACKTEST_WARMUP_CANDLES=150
# Binary options expiry upper bound (candles).
BACKTEST_MAX_EXPIRY_CANDLES=120
# Concurrent in-process backtest executions (single-process runner).
BACKTEST_MAX_CONCURRENT=1

# --- Phase 8: research / optimization ------------------------------------------------
# Hard cap on distinct parameter combinations per research run.
RESEARCH_MAX_COMBINATIONS=200
# Hard cap on parameter definitions (search-space dimensions) per run.
RESEARCH_MAX_PARAMETERS=8
# Hard cap on allowed values per parameter dimension.
RESEARCH_MAX_VALUES_PER_PARAMETER=12
# Hard cap on total engine walks per run (grid x phases + robustness scenarios).
RESEARCH_MAX_WALKS=1500
# Hard cap on walk-forward windows per run.
RESEARCH_MAX_WINDOWS=40
# Hard cap on execution-cost sensitivity scenarios per run.
RESEARCH_MAX_COST_SCENARIOS=6
# Bootstrap resamples for the OPTIONAL seeded stress test (0 disables it).
RESEARCH_BOOTSTRAP_SAMPLES=200
# Concurrent in-process research executions (single-process runner).
RESEARCH_MAX_CONCURRENT=1
# Per-owner cap on NEW research runs per minute (creation rate limit).
RESEARCH_MAX_CREATES_PER_MINUTE=10

# --- Phase 11: historical market replay ---------------------------------------------
# Hard cap on closed stored candles loaded into one replay session window.
REPLAY_MAX_CANDLES=20000
# Hard cap on candles returned by a single replay chart request.
REPLAY_MAX_CANDLES_RETURNED=5000
# Per-owner cap on NEW replay sessions per minute (creation rate limit).
REPLAY_MAX_CREATES_PER_MINUTE=30

# --- Phase 7: AI research layer (OPTIONAL — disabled by default) -----------------
# The AI layer EXPLAINS existing deterministic analysis results in plain
# language. It never replaces the analysis engine, never evaluates rules,
# never writes to the database and never executes generated code. The whole
# platform remains fully usable with AI_ENABLED=false (default).
AI_ENABLED=false

# OpenAI-compatible chat-completions endpoint (configurable — no vendor lock-in).
# Example: https://api.openai.com/v1  or a self-hosted gateway exposing the
# same /chat/completions contract. No specific model is assumed to exist.
AI_BASE_URL=
AI_MODEL=

# SERVER-SIDE ONLY. Never sent to the browser, never logged, never returned
# by any endpoint (GET /api/v1/ai/status reports booleans only). NEVER commit.
AI_API_KEY=

# Bounded behaviour: request timeout, retries for transient failures,
# per-owner sliding-window rate limit, prompt/output size caps.
AI_TIMEOUT_SECONDS=45
AI_MAX_RETRIES=2
AI_RETRY_BACKOFF_SECONDS=1.5
AI_RATE_LIMIT_PER_MINUTE=10
AI_MAX_INPUT_CHARS=24000
AI_MAX_OUTPUT_TOKENS=1400
AI_TEMPERATURE=0.1
